<Window x:Class="PrinterColorProfiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lentora ICU" Height="800" Width="1180" MinHeight="640" MinWidth="900"
        Background="{DynamicResource Bg}" FlowDirection="RightToLeft" FontFamily="{DynamicResource UiFont}"
        Icon="pack://application:,,,/Assets/Brand/icu.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Background="{DynamicResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: brand on the start side, global actions on the end side. -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Brand/icu-512.png" Width="38" Height="38" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lentora" FontFamily="{DynamicResource BrandFont}" FontSize="22" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="ICU" FontFamily="{DynamicResource BrandFont}" FontSize="22" Margin="8,0,0,0" Foreground="{DynamicResource AccentText}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="פרופיל צבע למדפסת · סורק ומשוב" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource Icon}" Click="ThemeButton_Click" ToolTip="מעבר בין ערכת צבעים בהירה לכהה"/>
                    <Button Content="אודות ורישיון" Style="{StaticResource Ghost}" Margin="0" Click="About_Click" ToolTip="גרסה, רישיון קוד פתוח ורכיבי צד שלישי"/>
                    <Button x:Name="HomeButton" Content="הפרופילים שלי" Style="{StaticResource Ghost}" Margin="0" Click="HomeButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step rail (right side in RTL). -->
            <Border x:Name="Rail" Grid.Column="0" Padding="22,26,18,20" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock x:Name="RailTitle" Style="{StaticResource H2}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="RailSubtitle" Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                    <StackPanel x:Name="Steps"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,26,36,30">
                <StackPanel x:Name="Body" MaxWidth="860" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>

        <!-- Status line: hidden until there is something to say. -->
        <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed" Padding="24,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="✕" Style="{StaticResource Icon}" Click="DismissStatus_Click" ToolTip="סגור הודעה"/>
                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" FontSize="14"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
